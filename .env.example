# Local AI (Ollama). No API key and no internet needed once the model is downloaded.
# 1) Install Ollama for Windows from https://ollama.com/download
# 2) In a terminal:  ollama pull llama3.2:3b
# 3) Ollama runs in the background on http://127.0.0.1:11434

# Tuned for a CPU-only PC (Dell OptiPlex 3050, i5-6500, 16 GB RAM).
# Fast mode model (default). Deep mode uses OLLAMA_MODEL_DEEP: run "ollama pull llama3.1:8b" once.
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_MODEL_DEEP="llama3.1:8b"
OLLAMA_NUM_CTX_DEEP="6144"

OLLAMA_URL="http://127.0.0.1:11434"
# 10 minutes, because CPU-only generation is slow.
OLLAMA_TIMEOUT_MS="600000"
# Smaller context = faster and uses less RAM.
OLLAMA_NUM_CTX="4096"
